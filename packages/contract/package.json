{
  "name": "@veil/veil-contract",
  "version": "0.1.0",
  "description": "Generated Compact contract artifacts for Veil Protocol v2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test:compile": "compact compile --skip-zk src/main.compact ./src/managed/veil-protocol",
    "test": "vitest",
    "test:run": "vitest run",
    "compile": "compact compile src/main.compact ./src/managed/veil-protocol",
    "build": "rm -rf dist && tsc --project tsconfig.build.json && mkdir -p dist/managed && cp -Rf ./src/managed/veil-protocol ./dist/managed/veil-protocol && cp ./src/main.compact ./dist && cp -Rf ./src/modules ./dist"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@types/bun": "latest",
    "vitest": "^4.0.2",
    "@veil-protocol/sdk": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0"
  }
}
