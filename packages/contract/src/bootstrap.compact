// Bootstrap deployment entrypoint.
//
// This contract has the same ledger layout and constructor as main.compact, but
// exports only the circuits needed immediately after deployment. The remaining
// circuit verifier keys can be installed later through contract maintenance.

pragma language_version >= 0.23.0;
import CompactStandardLibrary;
import "./modules/Utils" prefix Utils_;
import "./modules/GlobalLedgerStates" prefix LedgerStates_;
import "./modules/CustomStructs" prefix CustomStructs_;
import "./modules/Admin" prefix Admin_;
import "./modules/Scoring" prefix Scoring_;

export {
    /** Bootstrap entrypoints */
    Scoring_submitLiquidationEvent, Scoring_submitProtocolUsageEvent, Scoring_submitRepaymentEvent, 
    Scoring_createScoreEntry, Scoring_submitDebtStateEvent, Utils_generateUserPk, Admin_addIssuer,

    /** Custom struct definitions needed by TypeScript callers */
    CustomStructs_Issuer, CustomStructs_ScoreConfig,

    /** Ledger states */
    LedgerStates_issuerTrustWeights, LedgerStates_processedScoreEvents, LedgerStates_superAdmin,
    LedgerStates_issuers, LedgerStates_creditScoreCommitments, LedgerStates_scoreAccumulatorCommitments, LedgerStates_scoreConfig,
    LedgerStates_admins
};


constructor(
    _scoreConfig: CustomStructs_ScoreConfig,
) {
    LedgerStates_superAdmin = Utils_generateAdminPk(disclose(Utils_getLocalSecreteKey()));
    LedgerStates_scoreConfig = disclose(_scoreConfig);
}
