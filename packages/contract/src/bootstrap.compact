pragma language_version >= 0.23.0;
import CompactStandardLibrary;
import "./modules/Utils" prefix Utils_;
import "./modules/GlobalLedgerStates" prefix LedgerStates_;
import "./modules/CustomStructs" prefix CustomStructs_;
import "./modules/Scoring" prefix Scoring_;
import "./modules/Admin" prefix Admin_;
import "./modules/DIDRegistry" prefix DIDRegistry_;

export {
    /** Custom struct definitions */
    CustomStructs_CreditScore, CustomStructs_Issuer, CustomStructs_ScoreAccumulators, CustomStructs_ScoreConfig,
    CustomStructs_VeilDidRecord,

    /** Admin entrypoints */
    Admin_addIssuer, Admin_removeIssuer, Admin_addAdmin, Admin_removeAdmin, Admin_updatedScoreConfig,

    /** Ledger states */
    LedgerStates_issuerTrustWeights, LedgerStates_processedScoreEvents,
    LedgerStates_superAdmin, LedgerStates_issuers, LedgerStates_creditScoreCommitments, 
    LedgerStates_scoreAccumulatorCommitments, LedgerStates_scoreConfig, LedgerStates_admins,
    LedgerStates_didRecords,
    
    /** Utility circuits */
    Utils_generateUserPk
};

constructor(
    _scoreConfig: CustomStructs_ScoreConfig,
) {
    LedgerStates_superAdmin = Utils_generateAdminPk(disclose(Utils_getLocalSecreteKey()));
    LedgerStates_scoreConfig = disclose(_scoreConfig);
}
