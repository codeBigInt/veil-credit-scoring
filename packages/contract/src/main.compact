pragma language_version >= 0.23.0;
import CompactStandardLibrary;
import "./modules/Utils" prefix Utils_;
import "./modules/GlobalLedgerStates" prefix LedgerStates_;
import "./modules/CustomStructs" prefix CustomStructs_;
import "./modules/Identity" prefix Identity_;
import "./modules/Reputation" prefix Reputation_;
import "./modules/Governance" prefix Governance_;

export {
    /** Identity entrypoints */
    Identity_register, Identity_assertActive,

    /** Reputation entrypoints */
    Reputation_prove, Reputation_check,

    /** Governance entrypoints */
    Governance_proposeScoreConfig, Governance_applyScoreConfig, Governance_cancelScoreConfig,

    /** Custom struct definitions */
    CustomStructs_VeilIdentityRecord, CustomStructs_ReputationScore,
    CustomStructs_ReputationDecision, CustomStructs_ScoreConfig,
    CustomStructs_ReputationSignals, CustomStructs_ReputationProofBinding,
    CustomStructs_PendingScoreConfig, CustomStructs_GovernanceAction,
    CustomStructs_GuardianController,

    /** Ledger states */
    LedgerStates_identityRecords, LedgerStates_identityCommitments,
    LedgerStates_reputationCommitments, LedgerStates_processedProofs,
    LedgerStates_scoreConfig, LedgerStates_governanceControllerCommitment,
    LedgerStates_governanceGuardianSetHash, LedgerStates_governanceGuardianThreshold,
    LedgerStates_governanceControllerVersion,
    LedgerStates_configTimelockEpochs, LedgerStates_pendingScoreConfig,
    LedgerStates_hasPendingScoreConfig,

    /** Utility circuits */
    Utils_deriveVeilId,

    /** Generated pureCircuits helpers */
    Utils_deriveIdentityProofHash,
    Utils_deriveReputationWitnessCommitment,
    Utils_deriveReputationProofHash,
    Utils_deriveScoreConfigHashFor,
    Utils_deriveGovernanceActionHash,
    Utils_deriveGuardianControllerCommitment,
    Utils_deriveGovernanceProofHash,
    Utils_deriveCommunityWeightBps
};

constructor(
    _scoreConfig: CustomStructs_ScoreConfig,
    _governanceGuardianSetHash: Bytes<32>,
    _governanceGuardianThreshold: Uint<8>,
    _governanceControllerVersion: Uint<64>,
    _configTimelockEpochs: Uint<64>,
) {
    const scoreConfig = disclose(_scoreConfig);
    Utils_assertScoreConfigValid(scoreConfig);
    assert (disclose(_governanceGuardianSetHash) != default<Bytes<32>>, "Invalid guardian set");
    assert (disclose(_governanceGuardianThreshold) > 0, "Invalid guardian threshold");
    LedgerStates_scoreConfig = scoreConfig;
    LedgerStates_governanceGuardianSetHash = disclose(_governanceGuardianSetHash);
    LedgerStates_governanceGuardianThreshold = disclose(_governanceGuardianThreshold);
    LedgerStates_governanceControllerVersion = disclose(_governanceControllerVersion);
    LedgerStates_governanceControllerCommitment = Utils_deriveGuardianControllerCommitment(
        _governanceGuardianSetHash,
        _governanceGuardianThreshold,
        _governanceControllerVersion
    );
    LedgerStates_configTimelockEpochs = disclose(_configTimelockEpochs);
    LedgerStates_hasPendingScoreConfig = false;
}
