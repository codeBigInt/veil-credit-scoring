module GlobalLedgerStates {
    import CompactStandardLibrary;
    import CustomStructs prefix CustomStructs_;

    /**
       Public identity registry keyed by veilIdHash. The DID string is derived
       off-chain as did:veil:<veilIdHash>; no Spore DOB or issuer approval is used.
    */
    export ledger identityRecords: Map<Bytes<32>, CustomStructs_VeilIdentityRecord>;

    /**
       Commitment roots for public identity records and private reputation scores.
       The score body stays in private state; only commitments are inserted on-chain.
    */
    export ledger identityCommitments: HistoricMerkleTree<32, Bytes<32>>;
    export ledger reputationCommitments: HistoricMerkleTree<32, Bytes<32>>;

    /** Replay protection for registration and reputation updates. */
    export ledger processedProofs: Set<Bytes<32>>;

    /** On-chain scoring parameters controlled by timelocked guardian-council governance. */
    export ledger scoreConfig: CustomStructs_ScoreConfig;
 
    export ledger governanceControllerCommitment: Bytes<32>;
    export ledger governanceGuardianSetHash: Bytes<32>;
    export ledger governanceGuardianThreshold: Uint<8>;
    export ledger governanceControllerVersion: Uint<64>;
    export ledger configTimelockEpochs: Uint<64>;
    export ledger pendingScoreConfig: CustomStructs_PendingScoreConfig;
    export ledger hasPendingScoreConfig: Boolean;
}
