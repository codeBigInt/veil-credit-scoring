module CustomStructs {
    import CompactStandardLibrary;

    export struct VeilIdentityRecord {
        veilIdHash: Bytes<32>;
        chainNamespace: Bytes<32>;
        publicKeyOrLockHashCommitment: Bytes<32>;
        walletSignatureHash: Bytes<32>;
        chainProofHash: Bytes<32>;
        version: Uint<64>;
        status: Uint<8>; // 1 = active, 2 = revoked by owner/recovery flow
        createdAtEpoch: Uint<64>;
        updatedAtEpoch: Uint<64>;
    };

    export struct ReputationScore {
        veilIdHash: Bytes<32>;
        score: Uint<32>;
        band: Uint<8>; // 0 unranked, 1 bronze, 2 silver, 3 gold, 4 platinum
        walletAgeInDays: Uint<32>;
        distinctProtocols: Uint<32>;
        daoVoteCount: Uint<32>;
        lpTenureInDays: Uint<32>;
        crossChainCount: Uint<32>;
        txConsistencyScore: Uint<32>;
        ethChainCommitment: Bytes<32>;
        ckbChainCommitment: Bytes<32>;
        witnessCommitment: Bytes<32>;
        proofHash: Bytes<32>;
        lastUpdatedEpoch: Uint<64>;
        mtIndex: Uint<64>;
    };

    export struct ReputationSignals {
        walletAgeInDays: Uint<32>;
        distinctProtocols: Uint<32>;
        daoVoteCount: Uint<32>;
        lpTenureInDays: Uint<32>;
        crossChainCount: Uint<32>;
        txConsistencyScore: Uint<32>;
        ethChainCommitment: Bytes<32>;
        ckbChainCommitment: Bytes<32>;
        witnessSalt: Bytes<32>;
    };

    export struct ReputationProofBinding {
        veilIdHash: Bytes<32>;
        witnessCommitment: Bytes<32>;
        claimedBand: Uint<8>;
        scoreConfigHash: Bytes<32>;
        proofNonce: Bytes<32>;
    };

    export struct ReputationDecision {
        veilIdHash: Bytes<32>;
        meetsThreshold: Boolean;
        band: Uint<8>;
        communityWeightBps: Uint<32>;
        accessTier: Uint<8>;
        validAtEpoch: Uint<64>;
        purposeHash: Bytes<32>;
    };

    export struct ScoreConfig {
        baseScore: Uint<32>;
        maxScore: Uint<32>;
        walletAgeWeight: Uint<32>;
        protocolWeight: Uint<32>;
        daoWeight: Uint<32>;
        lpWeight: Uint<32>;
        crossChainWeight: Uint<32>;
        consistencyWeight: Uint<32>;
        bronzeThreshold: Uint<32>;
        silverThreshold: Uint<32>;
        goldThreshold: Uint<32>;
        platinumThreshold: Uint<32>;
    };

    export struct PendingScoreConfig {
        config: ScoreConfig;
        proposedByController: Bytes<32>;
        operationId: Bytes<32>;
        signatureBundleHash: Bytes<32>;
        proposedAtEpoch: Uint<64>;
        executableAtEpoch: Uint<64>;
    };

    export struct GovernanceAction {
        actionTag: Bytes<32>;
        scoreConfigHash: Bytes<32>;
        operationId: Bytes<32>;
        effectiveEpoch: Uint<64>;
    };

    export struct GuardianController {
        guardianSetHash: Bytes<32>;
        threshold: Uint<8>;
        controllerVersion: Uint<64>;
    };
}
