module Governance {
    import CompactStandardLibrary;
    import CustomStructs prefix CustomStructs_;
    import GlobalLedgerStates prefix LedgerStates_;
    import Utils prefix Utils_;

    export circuit proposeScoreConfig(
        _updatedScoreConfig: CustomStructs_ScoreConfig,
        _currentEpoch: Uint<64>,
        _operationId: Bytes<32>,
        _signatureBundleHash: Bytes<32>,
        _governanceNonce: Bytes<32>
    ): [] {
        const updatedScoreConfig = disclose(_updatedScoreConfig);
        Utils_assertScoreConfigValid(updatedScoreConfig);
        assert (LedgerStates_governanceControllerCommitment != default<Bytes<32>>, "Governance controller not configured");
        assert (LedgerStates_governanceGuardianSetHash != default<Bytes<32>>, "Guardian set not configured");
        assert (LedgerStates_governanceGuardianThreshold > 0, "Invalid guardian threshold");
        assert (disclose(_operationId) != default<Bytes<32>>, "Invalid governance operation");
        assert (disclose(_signatureBundleHash) != default<Bytes<32>>, "Invalid signature bundle");
        assert (disclose(_governanceNonce) != default<Bytes<32>>, "Invalid governance nonce");

        const updatedConfigHash = Utils_deriveScoreConfigHashFor(updatedScoreConfig, kernel.self().bytes);
        const governanceActionHash = Utils_deriveGovernanceActionHash(
            pad(32, "score-config"),
            updatedConfigHash,
            _operationId,
            _currentEpoch,
            kernel.self().bytes
        );
        const governanceProofHash = Utils_deriveGovernanceProofHash(
            LedgerStates_governanceControllerCommitment,
            governanceActionHash,
            _operationId,
            _signatureBundleHash,
            _governanceNonce,
            kernel.self().bytes
        );
        assert (governanceActionHash != default<Bytes<32>>, "Invalid governance action");
        assert (governanceProofHash != default<Bytes<32>>, "Invalid governance proof");

        const operationReplayKey = persistentHash<Vector<4, Bytes<32>>>([
            pad(32, "veil:v2:governance:operation"),
            LedgerStates_governanceControllerCommitment,
            disclose(_operationId),
            kernel.self().bytes
        ]);
        assert (!LedgerStates_processedProofs.member(operationReplayKey), "Governance operation already used");
        LedgerStates_processedProofs.insert(operationReplayKey);

        const nonceReplayKey = persistentHash<Vector<4, Bytes<32>>>([
            pad(32, "veil:v2:governance:nonce"),
            LedgerStates_governanceControllerCommitment,
            disclose(_governanceNonce),
            kernel.self().bytes
        ]);
        assert (!LedgerStates_processedProofs.member(nonceReplayKey), "Governance proof already used");
        LedgerStates_processedProofs.insert(nonceReplayKey);

        const executableAtEpoch = (disclose(_currentEpoch) + LedgerStates_configTimelockEpochs) as Uint<64>;
        LedgerStates_pendingScoreConfig = CustomStructs_PendingScoreConfig {
            config: updatedScoreConfig,
            proposedByController: LedgerStates_governanceControllerCommitment,
            operationId: disclose(_operationId),
            signatureBundleHash: disclose(_signatureBundleHash),
            proposedAtEpoch: disclose(_currentEpoch),
            executableAtEpoch: executableAtEpoch
        };
        LedgerStates_hasPendingScoreConfig = true;
    }

    export circuit applyScoreConfig(_currentEpoch: Uint<64>): [] {
        assert (LedgerStates_hasPendingScoreConfig, "No pending score config");
        assert (disclose(_currentEpoch) >= LedgerStates_pendingScoreConfig.executableAtEpoch, "Score config timelock active");

        Utils_assertScoreConfigValid(LedgerStates_pendingScoreConfig.config);
        LedgerStates_scoreConfig = LedgerStates_pendingScoreConfig.config;
        LedgerStates_hasPendingScoreConfig = false;
    }

    export circuit cancelScoreConfig(
        _operationId: Bytes<32>,
        _signatureBundleHash: Bytes<32>,
        _governanceNonce: Bytes<32>
    ): [] {
        assert (LedgerStates_governanceControllerCommitment != default<Bytes<32>>, "Governance controller not configured");
        assert (LedgerStates_hasPendingScoreConfig, "No pending score config");
        assert (disclose(_operationId) != default<Bytes<32>>, "Invalid governance operation");
        assert (disclose(_signatureBundleHash) != default<Bytes<32>>, "Invalid signature bundle");
        assert (disclose(_governanceNonce) != default<Bytes<32>>, "Invalid governance nonce");

        const governanceActionHash = Utils_deriveGovernanceActionHash(
            pad(32, "cancel-config"),
            default<Bytes<32>>,
            _operationId,
            LedgerStates_pendingScoreConfig.executableAtEpoch,
            kernel.self().bytes
        );
        const governanceProofHash = Utils_deriveGovernanceProofHash(
            LedgerStates_governanceControllerCommitment,
            governanceActionHash,
            _operationId,
            _signatureBundleHash,
            _governanceNonce,
            kernel.self().bytes
        );
        assert (governanceActionHash != default<Bytes<32>>, "Invalid governance action");
        assert (governanceProofHash != default<Bytes<32>>, "Invalid governance proof");

        const operationReplayKey = persistentHash<Vector<4, Bytes<32>>>([
            pad(32, "veil:v2:governance:operation"),
            LedgerStates_governanceControllerCommitment,
            disclose(_operationId),
            kernel.self().bytes
        ]);
        assert (!LedgerStates_processedProofs.member(operationReplayKey), "Governance operation already used");
        LedgerStates_processedProofs.insert(operationReplayKey);

        const nonceReplayKey = persistentHash<Vector<4, Bytes<32>>>([
            pad(32, "veil:v2:governance:nonce"),
            LedgerStates_governanceControllerCommitment,
            disclose(_governanceNonce),
            kernel.self().bytes
        ]);
        assert (!LedgerStates_processedProofs.member(nonceReplayKey), "Governance proof already used");
        LedgerStates_processedProofs.insert(nonceReplayKey);

        LedgerStates_hasPendingScoreConfig = false;
    }
}
