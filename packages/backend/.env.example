# HTTP
PORT=3001

# Mongo
MONGODB_URI=mongodb://localhost:27017/veil_backend
MONGODB_DB_NAME=veil_backend

# Midnight network
MIDNIGHT_NETWORK=preview
VEIL_PROOF_SERVER_URL=http://127.0.0.1:6300

# Funded backend operating wallet seed, used for deployment and backend transaction fees
VEIL_BACKEND_WALLET_SEED=<backend_wallet_seed>

# Separate sponsor wallet seed, funded with many small unregistered unshielded NIGHT UTXOs.
# If omitted, the backend falls back to VEIL_BACKEND_WALLET_SEED, which is useful for local
# testing but not recommended for production.
VEIL_SPONSOR_WALLET_SEED=<sponsor_wallet_seed>

# Fallback DUST budget used when a client cannot estimate the exact tx fee.
# Clients should send requiredDust for the transaction being sponsored when possible.
VEIL_SPONSOR_DEFAULT_REQUIRED_DUST=0

# Automatic reclaim of recorded sponsor allocations. Keep this short because
# every active allocation temporarily consumes sponsor UTxO capacity.
# Set interval to 0 to disable automatic reclaim.
VEIL_SPONSOR_ALLOCATION_TTL_MS=600000
VEIL_SPONSOR_RECLAIM_INTERVAL_MS=60000

# Contract address behavior
VEIL_CONTRACT_ADDRESS=f0d6c5095968a13f391b81ccb42132695e3493e058a9ac23ce155b6e6464d81d
VEIL_AUTO_DEPLOY=true

# ZK artifacts used only when backend deploys
VEIL_ZK_CONFIG_PATH=/absolute/path/to/packages/contract/dist/managed/veil-protocol
VEIL_BOOTSTRAP_ZK_CONFIG_PATH=/absolute/path/to/packages/contract/dist/managed/veil-protocol-bootstrap
